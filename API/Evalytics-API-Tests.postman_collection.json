      "item": [
        {
          "name": "List public surveys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/survey",
              "host": ["{{baseUrl}}"],
              "path": ["survey"]
            }
          }
        },
        {
          "name": "Get survey by public ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Respondent-Token",
                "value": "{{respondentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/survey/{{publicId}}",
              "host": ["{{baseUrl}}"],
              "path": ["survey", "{{publicId}}"]
            }
          }
        },
        {
          "name": "Submit survey response",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Respondent-Token",
                "value": "{{respondentToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"satisfaction\": 5,\n    \"feedback\": \"Excellent service via Postman!\"\n  },\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/survey/{{publicId}}/response",
              "host": ["{{baseUrl}}"],
              "path": ["survey", "{{publicId}}", "response"]
            }
          }
        },
        {
          "name": "Get current response",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Respondent-Token",
                "value": "{{respondentToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/survey/{{publicId}}/response",
              "host": ["{{baseUrl}}"],
              "path": ["survey", "{{publicId}}", "response"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Responses (Admin)",
      "item": [
        {
          "name": "List all responses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Token",
                "value": "{{apiToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/responses",
              "host": ["{{baseUrl}}"],
              "path": ["responses"]
            }
          }
        },
        {
          "name": "List responses by campaign",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Token",
                "value": "{{apiToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/responses?campaign_id={{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["responses"],
              "query": [
                {
                  "key": "campaign_id",
                  "value": "{{campaignId}}"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}

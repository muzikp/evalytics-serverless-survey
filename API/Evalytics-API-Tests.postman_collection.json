            },
            "url": {
              "raw": "{{baseUrl}}/snapshots",
              "host": ["{{baseUrl}}"],
              "path": ["snapshots"]
            }
          }
        },
        {
          "name": "Get snapshot by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Token",
                "value": "{{apiToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/snapshots/{{snapshotId}}",
              "host": ["{{baseUrl}}"],
              "path": ["snapshots", "{{snapshotId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Campaigns",
      "item": [
        {
          "name": "List campaigns",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Token",
                "value": "{{apiToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/campaigns",
              "host": ["{{baseUrl}}"],
              "path": ["campaigns"]
            }
          }
        },
        {
          "name": "Create campaign",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('campaignId', json.campaign_id);",
                  "    pm.collectionVariables.set('publicId', json.public_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Token",
                "value": "{{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"snapshot_id\": \"{{snapshotId}}\",\n  \"title\": {\"en\": \"Q1 Customer Feedback\"},\n  \"description\": {\"en\": \"Help us improve our service\"},\n  \"email_template\": {\n    \"invite\": {\n      \"subject\": \"Please complete our survey\",\n      \"html\": \"<p>Dear customer,</p><p>Please click: {{survey_link}}</p>\"\n    }\n  },\n  \"allow_multiple_responses\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/campaigns",
              "host": ["{{baseUrl}}"],
              "path": ["campaigns"]
            }
          }
        },
        {
          "name": "Get campaign by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Token",
                "value": "{{apiToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{campaignId}}",
              "host": ["{{baseUrl}}"],
              "path": ["campaigns", "{{campaignId}}"]
            }
          }
        },
        {
          "name": "Add respondents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    if (json.respondents && json.respondents.length > 0) {",
                  "        pm.collectionVariables.set('respondentToken', json.respondents[0].token);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Token",
                "value": "{{apiToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"respondents\": [\n    {\"email\": \"test1@example.com\"},\n    {\"email\": \"test2@example.com\"}\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{campaignId}}/respondents",
              "host": ["{{baseUrl}}"],
              "path": ["campaigns", "{{campaignId}}", "respondents"]
            }
          }
        },
        {
          "name": "List respondents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Token",
                "value": "{{apiToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/campaigns/{{campaignId}}/respondents",
              "host": ["{{baseUrl}}"],
              "path": ["campaigns", "{{campaignId}}", "respondents"]
            }
          }
        }
      ]
